---
import "../styles/global.css";
import site, { rubrykaSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("ciekawa.com.pl")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Literata:opsz,wght@7..72,500;7..72,600;7..72,700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-paper font-sans text-ink antialiased">
    <div class="border-b-2 border-ink bg-ink text-paper">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-2 font-mono text-[10px] uppercase tracking-widest">
        <span>Skoroszyt · {site.issue}</span>
        <span>{site.city}</span>
      </div>
    </div>

    <header class="ruled-bg border-b border-ruled">
      <div class="mx-auto grid max-w-5xl gap-6 px-4 py-8 md:grid-cols-[1fr_auto] md:items-end">
        <a href="/">
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-stamp">ciekawostki bez krzyku</p>
          <h1 class="font-serif text-4xl font-bold tracking-tight md:text-5xl">{site.name}</h1>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-pencil">{site.tagline}</p>
        </a>
        <nav class="flex flex-wrap gap-x-1 gap-y-1 font-mono text-[11px] uppercase">
          <a href="/" class="border border-ink/20 px-3 py-1.5 hover:bg-ink hover:text-paper">Start</a>
          <a href="/notatki/" class="border border-ink/20 px-3 py-1.5 hover:bg-ink hover:text-paper">Notatki</a>
          <a href="/rubryki/" class="border border-ink/20 px-3 py-1.5 hover:bg-ink hover:text-paper">Rubryki</a>
          <a href="/redakcja/" class="border border-ink/20 px-3 py-1.5 hover:bg-ink hover:text-paper">Redakcja</a>
          <a href="/kontakt/" class="border border-ink/20 px-3 py-1.5 hover:bg-ink hover:text-paper">Kontakt</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t-2 border-ink bg-ink text-paper">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 md:grid-cols-3">
        <div>
          <p class="font-serif text-2xl font-bold">{site.name}</p>
          <p class="mt-2 text-sm text-paper/75">{site.address}</p>
          <p class="stamp-box mt-4 inline-block px-3 py-1 font-mono text-[10px] uppercase text-stamp">{site.issue}</p>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-paper/60">Rubryki</p>
          <ul class="mt-3 space-y-1 text-sm">
            {site.rubryki.map((r) => (
              <li><a class="hover:text-stamp" href={`/rubryki/${rubrykaSlug(r.name)}/`}>{r.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-paper/75">
          <p>To nie jest portal „wow”. To skoroszyt — krótkie teksty o tym, co naprawdę zatrzymuje wzrok na chwilę dłużej niż scroll.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline hover:text-stamp">Prywatność</a> · <a href="/regulamin/" class="underline hover:text-stamp">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"PLACEHOLDER_ANALYTICS"}'></script>
  </body>
</html>
