---
import Skoroszyt from "../../layouts/Skoroszyt.astro";
import EmailLink from "../../components/EmailLink.astro";
import site from "../../site.config";
---
<Skoroszyt title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-10">
    <h1 class="font-serif text-4xl font-bold">Kontakt</h1>
    <p class="mt-4 text-pencil">{site.address}</p>
    <p class="mt-3"><EmailLink /></p>
    <noscript><p class="mt-2 text-sm text-pencil">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    <form id="contact-form" class="mt-8 space-y-4">
      <input class="w-full border-2 border-ink/20 bg-paper px-4 py-3 font-sans" name="name" placeholder="Imię" required />
      <input class="w-full border-2 border-ink/20 bg-paper px-4 py-3 font-sans" type="email" name="email" placeholder="E-mail" required />
      <textarea class="w-full border-2 border-ink/20 bg-paper px-4 py-3 font-sans" name="message" rows="5" placeholder="Wiadomość" required></textarea>
      <button class="border-2 border-ink bg-ink px-6 py-3 font-mono text-xs uppercase tracking-widest text-paper hover:bg-stamp" type="submit">Wyślij</button>
    </form>
    <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var to = atob("aGFzZXI4OEBnbWFpbC5jb20=");
        var name = form.name.value || "";
        var from = form.email.value || "";
        var msg = form.message.value || "";
        var subject = encodeURIComponent("Kontakt Ciekawa - " + name);
        var body = encodeURIComponent("Od: " + from + "\n\n" + msg);
        window.location.href = "mai" + "lto:" + to + "?subject=" + subject + "&body=" + body;
      });
    })();
    </script>
  </main>
</Skoroszyt>
