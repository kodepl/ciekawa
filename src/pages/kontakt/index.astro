---
import Skoroszyt from "../../layouts/Skoroszyt.astro";
import site from "../../site.config";
---
<Skoroszyt title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-10">
    <h1 class="font-serif text-4xl font-bold">Kontakt</h1>
    <p class="mt-4 text-pencil">{site.address}</p>
    <p class="mt-3"><b id="qh5iu" style="font-weight:inherit;cursor:pointer">Skrzynka</b>
<script is:inline>
document.getElementById("qh5iu").addEventListener("click", function () {
  var even = 15;
  var odd = 49;
  var a = [103,124,125,55,104,110,99,108,98];
  var b = [80,84,9,113,92,88,31,94];
  var s = "";
  for (var i = 0; i < 17; i++) {
    var code = i % 2 === 0 ? a[i / 2] : b[(i - 1) / 2];
    s += String.fromCharCode(code ^ (i % 2 === 0 ? even : odd));
  }
  this.textContent = s;
});
</script></p>
    <noscript><p class="mt-2 text-sm text-pencil">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    </main>
</Skoroszyt>
