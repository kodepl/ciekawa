---
import Skoroszyt from "../../layouts/Skoroszyt.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("notatki")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---
<Skoroszyt title="Notatki" description="Archiwum skoroszytu Ciekawa">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-serif text-4xl font-bold">Notatki</h1>
    <ul class="mt-10 space-y-0">
      {page.data.map((post, i) => (
        <li class="flex gap-4 border-b border-ruled py-6">
          <span class="font-mono text-sm text-stamp">{String((page.currentPage - 1) * page.size + i + 1).padStart(2, "0")}</span>
          <div class="flex-1">
            <p class="font-mono text-[10px] uppercase text-pencil">{post.data.rubryka} · {post.data.issue}</p>
            <a href={`/notatki/${post.slug}/`} class="font-serif text-2xl font-semibold hover:text-stamp">{post.data.title}</a>
            <p class="mt-1 text-sm text-pencil">{post.data.description}</p>
          </div>
          <img src={coverFor(post.data.rubryka, post.data.image)} alt="" class="hidden h-16 w-20 border border-ink/20 object-cover sm:block" />
        </li>
      ))}
    </ul>
  </main>

  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm" aria-label="Paginacja">
      {page.url.prev ? (
        <a href={page.url.prev} class="underline-offset-2 hover:underline">← Nowsze</a>
      ) : (
        <span class="opacity-40">← Nowsze</span>
      )}
      <span class="tabular-nums opacity-70">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="underline-offset-2 hover:underline">Starsze →</a>
      ) : (
        <span class="opacity-40">Starsze →</span>
      )}
    </nav>
  )}

</Skoroszyt>
